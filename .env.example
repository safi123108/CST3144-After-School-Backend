# Server HTTP port (Render sets PORT automatically in production)
PORT=3000

# MongoDB Atlas connection string (replace placeholders with your own cluster credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Target MongoDB database name
DB_NAME=after_school_app

# Optional comma-separated list of allowed browser CORS origins.
# Example: http://127.0.0.1:5500,http://localhost:5500,https://<github-username>.github.io
# Leave blank for the default open non-credentialed CORS policy compatible with local development.
CORS_ORIGIN=

